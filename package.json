{
  "name": "ecoairlines",
  "version": "2.0.0",
  "description": "EcoAirlines — Reto 2: microservicios (packages/ y services/). El monolito del Reto 1 se retiró en V2.21.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/gestion/*",
    "services/respuesta/*",
    "services/externos/*",
    "services/esb",
    "services/gateway"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.spec.json",
    "lint": "oxlint tests packages services",
    "format": "prettier --write \"{packages,services}/**/{src,test}/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run --config ./vitest.config.v2.ts",
    "test:v2": "vitest run --config ./vitest.config.v2.ts",
    "test:infra": "vitest run --config ./vitest.config.v2.ts postgres.spec bus.spec",
    "test:pact": "vitest run --config ./tests/contratos-pact/vitest.config.ts consumidor",
    "test:pact:verify": "vitest run --config ./tests/contratos-pact/vitest.config.ts proveedor",
    "test:conformidad-v2": "vitest run --config ./tests/conformidad-v2/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:up": "node scripts/e2e/levantar.mjs",
    "e2e:down": "node scripts/e2e/levantar.mjs down",
    "e2e:conformidad": "node scripts/e2e/conformidad.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "scarfSettings": {
    "enabled": false
  }
}
