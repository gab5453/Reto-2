# Copiar a infra/.env y cambiar los valores. SOLO DESARROLLO: en la nube los secretos se configuran en la plataforma.
POSTGRES_ADMIN_USER=ecoairlines_admin
POSTGRES_ADMIN_PASSWORD=cambiar-admin
PG_PASSWORD_IDENTITY=cambiar-identity
PG_PASSWORD_CUSTOMERS=cambiar-customers
PG_PASSWORD_WEBHOOKS=cambiar-webhooks
PG_PASSWORD_SCHEDULE=cambiar-schedule
PG_PASSWORD_OFFERS=cambiar-offers
PG_PASSWORD_FLIGHT_STATUS=cambiar-flight-status
PG_PASSWORD_BOOKINGS=cambiar-bookings
PG_PASSWORD_POST_SALE=cambiar-post-sale
PG_PASSWORD_CHECK_IN=cambiar-check-in
PG_PASSWORD_ESB=cambiar-esb
PG_PASSWORD_PAYMENT=cambiar-payment
RABBITMQ_USER=ecoairlines
RABBITMQ_PASSWORD=cambiar-rabbitmq
BOOKING_SIM_WEBHOOK_SECRET=secreto-de-prueba-booking-simulado
AIRLINE_EVENTS_SECRET=secreto-de-prueba-eventos-booking
# MS.G.Identity (V2.3). IDENTITY_PRIVATE_KEY vacío = clave temporal en cada arranque (solo local).
IDENTITY_PRIVATE_KEY=
ADMIN_PASSWORD=cambiar-admin-ecoairlines
BOOKING_CLIENT_SECRET=cambiar-secreto-booking-0001
ESB_CLIENT_SECRET=cambiar-secreto-esb-0001
# MS.G.Offers (V2.5): a dónde envía el stock (local: el simulador; nube: booking.epn.edu.ec:50051).
BOOKING_GRPC_ADDRESS=booking-simulado:50051
# MS.G.Webhooks (V2.8): cifra los secretos de las suscripciones (mínimo 32 caracteres).
WEBHOOKS_ENCRYPTION_KEY=cambiar-por-una-clave-larga-de-32-caracteres-o-mas
# ESB (V2.9). BOOKING_BUS_URL: bus de Booking (BKG-01); vacío = nuestro RabbitMQ (solo local). AIRLINE_EVENTS_URL: a dónde
# envía booking-simulado sus eventos (local: el ESB; con el gateway, /api/integraciones/booking/eventos).
BOOKING_BUS_URL=
AIRLINE_EVENTS_URL=http://esb:8080/integraciones/booking/eventos

# Clientes internos de los MS de respuesta en Identity (D44, V2.12). En la nube: secretos propios de 16+ caracteres.
MS_VUELOS_CLIENT_SECRET=secreto-ms-vuelos-dev-solo-local-0001
MS_RESERVAS_CLIENT_SECRET=secreto-ms-reservas-dev-solo-local-0001
MS_POSTVENTA_CLIENT_SECRET=secreto-ms-postventa-dev-solo-local-0001
MS_CLIENTES_CLIENT_SECRET=secreto-ms-clientes-dev-solo-local-0001
MS_ADMIN_CLIENT_SECRET=secreto-ms-admin-dev-solo-local-0001

# Puerto del gateway en el host (V2.13): http://localhost:8088/api/v2/vuelos, /api/graphql y /api/docs.
# Windows suele reservar el 8080 (http.sys); dentro de la red de Docker el gateway sigue en 8080.
GATEWAY_HOST_PORT=8088

# Payment API simulada (V2.15): clave pública (navegador) y secreta (ESB). En la nube, propias (scripts/cloud/generar-env.mjs).
PAYMENT_PUBLISHABLE_KEY=pk_test_dev_solo_local_ecoairlines_0001
PAYMENT_SECRET_KEY=sk_test_dev_solo_local_ecoairlines_0001

# Grafana (V2.16): http://localhost:3001 (usuario admin). En la nube, propia (scripts/cloud/generar-env.mjs).
GRAFANA_ADMIN_PASSWORD=dev-grafana-solo-local
