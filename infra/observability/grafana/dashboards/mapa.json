{
  "uid": "ecoairlines-mapa",
  "title": "EcoAirlines — Mapa del sistema en vivo",
  "description": "Grafo de servicios a partir de las trazas (Tempo metrics-generator → Prometheus) y búsqueda de un proceso por su correlation ID (TraceQL). PLAN_Telemetria_Asientos T-3.",
  "tags": [
    "ecoairlines",
    "t-3"
  ],
  "schemaVersion": 41,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "correlation_id",
        "label": "X-Correlation-Id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Pega un correlation ID (corr-…) para ver sus trazas en Tempo."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "Mapa de servicios (últimos minutos): peticiones, errores y latencia por arista",
      "description": "Cada nodo es un servicio con trazas (también la Payment API); cada flecha, llamadas de un servicio a otro, con su latencia promedio y peticiones por segundo. Sale de las trazas: aparece unos 15–30 s después del tráfico. Las llamadas a PostgreSQL y RabbitMQ no tienen spans propios, así que no aparecen como nodos.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Aristas: quién llama a quién (últimos 5 min)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[5m])) * 60",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total[5m])) * 60",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_server_seconds_bucket[5m])))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client": "Desde",
              "server": "Hacia",
              "Value #A": "Peticiones/min",
              "Value #B": "Errores/min",
              "Value #C": "p95 (ms)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Peticiones/min",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errores/min"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.01
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peticiones por segundo que recibe cada servicio",
      "gridPos": {
        "x": 14,
        "y": 20,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (server) (rate(traces_service_graph_request_total[1m]))",
          "legendFormat": "{{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Trazas del correlation ID «$correlation_id» (Tempo)",
      "description": "Todas las trazas cuyos spans llevan ese correlation_id. Al abrir una se ven su cascada y su grafo de nodos.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.correlation_id = \"$correlation_id\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
