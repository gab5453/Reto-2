{
  "consumer": {
    "name": "ms-respuesta"
  },
  "interactions": [
    {
      "description": "la consulta de una saga compensada por su dueño",
      "pending": false,
      "providerStates": [
        {
          "name": "la saga de crear reserva del usuario de Booking se compensó por asiento tomado"
        }
      ],
      "request": {
        "headers": {
          "authorization": [
            "Bearer token-de-servicio-de-ejemplo"
          ],
          "x-owner-id": [
            "partner:BOOKING_PROTOTIPO:usr-pact"
          ]
        },
        "matchingRules": {
          "header": {
            "authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/sagas/8b2c3d4e-5f6a-4b7c-9d8e-0f1a2b3c4d5e"
      },
      "response": {
        "body": {
          "content": {
            "error": {
              "code": "SEAT_TAKEN",
              "status": 409,
              "title": "Asiento no disponible"
            },
            "sagaId": "8b2c3d4e-5f6a-4b7c-9d8e-0f1a2b3c4d5e",
            "status": "COMPENSATED"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sagaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "la consulta de una saga completada por su dueño",
      "pending": false,
      "providerStates": [
        {
