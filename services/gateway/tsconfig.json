{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Para compilar no hacen falta los tipos de vitest del tsconfig base (las pruebas se excluyen del build).
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [{ "path": "../../packages/shared" }]
}
